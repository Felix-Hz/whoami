{
  "name": "whoami",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "concurrently -k -n site,studio -c cyan,magenta \"pnpm dev:site\" \"pnpm dev:studio\"",
    "dev:site": "pnpm dev:fetch || echo \"content fetch failed, using existing src/generated/posts.json\"; vite",
    "dev:studio": "pnpm --filter @whoami/studio dev",
    "dev:fetch": "tsx --env-file=.env scripts/fetch-content.ts --preview",
    "prebuild": "tsx --env-file-if-exists=.env scripts/fetch-content.ts",
    "build": "pnpm prebuild && tsc -b && vite build && tsx --tsconfig tsconfig.app.json --import ./scripts/register-preact-compat.ts scripts/prerender.ts",
    "check:leaks": "bash scripts/check-authoring-leak.sh dist",
    "typegen": "pnpm --filter @whoami/studio exec sanity schema extract --enforce-required-fields --force && pnpm --filter @whoami/studio exec sanity typegen generate",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^8.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "preact": "^11.0.1",
    "preact-router": "^4.1.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "2.6.2",
    "@sanity/types": "^6.19.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "groq": "^6.19.0",
    "preact-render-to-string": "^6.8.1",
    "satori": "0.59.1",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
