SANITY_PROJECT_ID=
SANITY_DATASET=production
# Not needed: the dataset is public
SANITY_API_TOKEN=
VITE_GA_TRACKING_ID=

# Dev-only, server-side. Never prefix these with VITE_.
# Sanity Viewer token: shows drafts and unpublished changes in `pnpm dev`
SANITY_PREVIEW_TOKEN=
# Fine-grained GitHub token, this repo only, Actions: read-only. Enables the deploy status widget.
GITHUB_TOKEN=
# Studio the authoring links open (default http://localhost:3333)
STUDIO_URL=
